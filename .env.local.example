# Copiar a .env.local y completar con los datos de tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Secreta: Project Settings → API → "service_role". NUNCA exponerla al
# navegador (no lleva el prefijo NEXT_PUBLIC_). Se usa solo en server-side
# para el enlace público del gestor de campo y la subida de archivos.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Cuenta de Gmail usada para enviar las notificaciones por mail (inicio de
# trámite, contacto con el asegurado, gestor asignado, traslado,
# presentación de baja). GMAIL_APP_PASSWORD NO es la contraseña normal de
# la cuenta: hay que activar la verificación en 2 pasos en la cuenta de
# Gmail y generar una "Contraseña de aplicación" (myaccount.google.com →
# Seguridad → Contraseñas de aplicaciones → app "Correo").
GMAIL_USER=tu-cuenta@gmail.com
GMAIL_APP_PASSWORD=tu-contraseña-de-aplicación

# Opcional. Clave de la API de Anthropic (console.anthropic.com → API keys).
# Se usa solo para el botón "Sugerir con IA" de la novedad del seguimiento al
# productor (borrador que una persona revisa antes de enviar). Sin esta
# variable el resto del sistema funciona igual; solo ese botón avisa que la
# IA no está configurada. Secreta: nunca con el prefijo NEXT_PUBLIC_.
ANTHROPIC_API_KEY=tu-api-key-de-anthropic
